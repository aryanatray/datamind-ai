# Run infrastructure/scripts/setup.py to generate actual local secrets in .env.
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=generate-with-setup
ENCRYPTION_KEY=generate-with-setup
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PLATFORM_ADMIN_EMAIL=owner@example.com
# Set by the local admin.py bootstrap tool after registration; an unverified email grants no privileges.
PLATFORM_ADMIN_USER_ID=
GEMINI_API_KEY=
# Choose a model available to your Google project.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE=./data/models
STORAGE_ROOT=./data/files
SQLITE_ROOT=./data/sources
DB_ALLOWED_HOSTS=localhost,127.0.0.1,postgres,mysql,mongo
# Optional operator-owned CA bundle for enterprise database TLS. Otherwise use public certificate roots.
DB_CA_FILE=
SEARXNG_URL=http://localhost:18080
MAX_UPLOAD_MB=20
MAX_QUERY_ROWS=500
MAX_RESULT_BYTES=2000000
QUERY_TIMEOUT_SECONDS=10
USER_REQUESTS_PER_MINUTE=12
WORKSPACE_REQUESTS_PER_MINUTE=30
GLOBAL_DAILY_TOKEN_LIMIT=1000000
USER_DAILY_TOKEN_LIMIT=100000
# Compose-only application and disposable demo passwords are generated by setup.py.
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
DEMO_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
